{$PUBLIC_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 32MB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    reverse_proxy app:8000 {
        transport http {
            response_header_timeout 60s
        }
    }
}
